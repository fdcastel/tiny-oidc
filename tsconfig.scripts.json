// Node-side code: repository scripts, tool configs, the e2e suite and the example RP.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "perf/**/*.ts",
    "conformance/**/*.ts",
    "test/e2e/**/*.ts",
    "test/scripts/**/*.ts",
    "examples/rp-node/**/*.ts",
    "*.config.ts"
  ]
}
